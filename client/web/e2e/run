#!/bin/sh
# Run the web client e2e suite against a throwaway container stack.
# Purpose: build the server image and the production web bundle, bring the
#   stack up (compose project paranoia-e2e, ports 18000/15173), run
#   Playwright from the official Podman image, then tear everything down,
#   also on failure or interrupt. Exit status is Playwright's.
# Scope: Podman only (podman-compose, rootless); nothing installed on the
#   host. Extra arguments go to `playwright test`, e.g. ./run -g omit.
# Limitations: pass PLAYWRIGHT_IMAGE to override the image (its tag must
#   match the @playwright/test version in package.json). Set KEEP_IMAGE=1
#   to keep the built server image between runs. A temporary rootless
#   Podman API socket is started so tests can restart the server.
PW_IMAGE="${PLAYWRIGHT_IMAGE:-mcr.microsoft.com/playwright:v1.63.0-noble}"
NODE_IMAGE="${NODE_IMAGE:-docker.io/library/node:24-alpine}"
SERVER_IMAGE=paranoia-e2e-server:latest
HERE="$(cd "$(dirname "$0")" && pwd)"
WEB="$(dirname "$HERE")"
ROOT="$(dirname "$(dirname "$WEB")")"
COMPOSE="podman-compose -f $HERE/compose.yaml -p paranoia-e2e"
TMP="$(mktemp -d)"
SOCK="$TMP/podman.sock"
SVC_PID=""

# Tear down everything this script created.
cleanup() {
  $COMPOSE down -t 2 >/dev/null 2>&1
  [ -n "$SVC_PID" ] && kill "$SVC_PID" 2>/dev/null
  rm -rf "$TMP"
  [ -z "$KEEP_IMAGE" ] && podman rmi "$SERVER_IMAGE" >/dev/null 2>&1
}
trap cleanup EXIT
trap 'exit 130' INT TERM

set -e
echo "== building server image"
podman build -q --format docker -t "$SERVER_IMAGE" \
  -f "$ROOT/server/Containerfile" "$ROOT/server"

echo "== building web client"
podman run --rm -v "$WEB":/app:Z -w /app "$NODE_IMAGE" \
  sh -c 'npm ci --no-audit --no-fund && npm run build'

echo "== starting stack"
podman system service --time=0 "unix://$SOCK" &
SVC_PID=$!
$COMPOSE up -d

echo "== running tests"
set +e
podman run --rm --network host --ipc=host --security-opt label=disable \
  -v "$HERE":/e2e:Z -v "$SOCK":/run/podman.sock \
  -v "$ROOT/server/paranoia/data/pokemon.txt":/data/pokemon.txt:ro,Z \
  -e CI=1 -e E2E_PODMAN_SOCK=/run/podman.sock \
  -e E2E_POKEMON_FILE=/data/pokemon.txt -w /e2e "$PW_IMAGE" \
  sh -c 'npm ci --no-audit --no-fund && npx playwright test "$@"' sh "$@"
STATUS=$?
exit "$STATUS"
