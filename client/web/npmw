#!/bin/sh
# Run npm (or any command after `--`) inside a rootless Podman container.
# Purpose: Node is not installed on the host; all JS tooling runs here.
# Scope: mounts client/web at /app. Only for `run dev` it also publishes the
#   Vite port: 127.0.0.1:5173 on the host (override with NPMW_PORT and
#   NPMW_BIND, e.g. NPMW_BIND=0.0.0.0 for phone testing) -> container
#   port 5000, and points the dev proxy at the host's server on port 8000.
# Limitations: needs Podman and network access to pull the image once.
#   Override the image with NODE_IMAGE; extra podman flags with PODMAN_ARGS;
#   the proxy target with VITE_PROXY_TARGET (the server must listen on a
#   host address the container can reach, e.g. 0.0.0.0).
#   Usage: ./npmw run dev | ./npmw test | ./npmw -- node -v
IMAGE="${NODE_IMAGE:-docker.io/library/node:24-alpine}"
cd "$(dirname "$0")" || exit 1
if [ "$1" = "--" ]; then shift; CMD="$*"; else CMD="npm $*"; fi
TTY=""
[ -t 0 ] && TTY="-it"
PORT=""
case "$CMD" in
  "npm run dev"*)
    PORT="-p ${NPMW_BIND:-127.0.0.1}:${NPMW_PORT:-5173}:5000"
    VITE_PROXY_TARGET="${VITE_PROXY_TARGET:-http://host.containers.internal:8000}"
    export VITE_PROXY_TARGET ;;
esac
# shellcheck disable=SC2086
exec podman run --rm $TTY -v "$PWD":/app:z -w /app $PORT \
  -e VITE_PROXY_TARGET -e VITE_WS_URL $PODMAN_ARGS "$IMAGE" sh -c "$CMD"
